// AleaQuant — configuration de publication
// 2026-10-01 : domaine aleaquant.org raccordé au Worker existant.
{
  "name": "aleaquant",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "aleaquant.org",
      "custom_domain": true
    }
  ]
}
