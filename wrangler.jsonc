// AleaQuant — configuration de publication
// 2026-10-01 : domaine aleaquant.org raccordé au Worker existant.
{
  "name": "aleaquant",
  "compatibility_date": "2026-09-29",
  // v1.0 documentary prerequisites: the standard deployment fails before upload.
  "build": {
    "command": "python3 scripts/check_content_dependencies.py --live-on-deploy"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "aleaquant.org",
      "custom_domain": true
    }
  ]
}
