<?xml version="1.0" encoding="UTF-8"?>
<!--
  Rafraîchissement automatique des tirages AleaQuant (chantier B3).

  Installation :
    cp tools/com.aleaquant.refresh.plist ~/Library/LaunchAgents/
    launchctl load -w ~/Library/LaunchAgents/com.aleaquant.refresh.plist
  Vérification :
    launchctl list | grep aleaquant
    tail -f ~/Library/Logs/aleaquant-refresh.log
  Déclenchement manuel :
    launchctl start com.aleaquant.refresh
  Désinstallation :
    launchctl unload -w ~/Library/LaunchAgents/com.aleaquant.refresh.plist

  Horaires : tous les jours à 8 h 12 puis à 13 h 12. Keno tire chaque soir,
  Loto trois jours par semaine et EuroMillions deux ; chaque passage vérifie les
  trois archives et ne recalcule que les jeux dont une révision a changé.

  Ce travail ne publie RIEN : il ingère, recalcule, et laisse les modifications non
  committées. La mise en ligne reste une décision humaine.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.aleaquant.refresh</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/chris/aleaquant-web/tools/refresh_draws.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/chris/aleaquant-web</string>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>12</integer></dict>
    <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>12</integer></dict>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/chris/Library/Logs/aleaquant-refresh.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/chris/Library/Logs/aleaquant-refresh.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
