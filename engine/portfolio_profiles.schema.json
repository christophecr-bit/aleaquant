{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aleaquant:portfolio-profiles:0.1",
  "title": "Prototype EuroMillions 0.1 import\u00e9 strictement",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "game": {
      "type": "string",
      "const": "euromillions"
    },
    "unit_price_eur": {
      "type": "number",
      "enum": [
        2.5
      ]
    },
    "pool_seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "draws": {
          "type": "integer",
          "minimum": 10000,
          "maximum": 1000000
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "draws",
        "seed"
      ],
      "additionalProperties": false
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "[a-z][a-z0-9_]{0,63}"
          },
          "family": {
            "type": "string",
            "enum": [
              "Complete",
              "Balanced",
              "Spread",
              "Clustered"
            ]
          },
          "constraints": {
            "type": "object",
            "properties": {
              "grid_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2000
              },
              "budget_max_eur": {
                "type": "number",
                "minimum": 2.5,
                "maximum": 5000
              },
              "pool_number_count": {
                "type": "integer",
                "minimum": 5,
                "maximum": 50
              },
              "pool_star_count": {
                "type": "integer",
                "minimum": 2,
                "maximum": 12
              },
              "unique_grids": {
                "type": "boolean",
                "const": true
              }
            },
            "required": [
              "grid_count",
              "budget_max_eur",
              "pool_number_count",
              "pool_star_count",
              "unique_grids"
            ],
            "additionalProperties": false
          },
          "objectives": {
            "type": "object",
            "properties": {
              "maximize_distinct_triples": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000
              },
              "maximize_distinct_pairs": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000
              },
              "balance_number_frequency": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000
              },
              "balance_star_frequency": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000
              },
              "minimize_overlap": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000
              }
            },
            "required": [
              "maximize_distinct_triples",
              "maximize_distinct_pairs",
              "balance_number_frequency",
              "balance_star_frequency",
              "minimize_overlap"
            ],
            "additionalProperties": false
          },
          "search": {
            "type": "object",
            "properties": {
              "candidates_per_step": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "seed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              }
            },
            "required": [
              "candidates_per_step",
              "seed"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "family",
          "constraints",
          "objectives",
          "search"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "game",
    "unit_price_eur",
    "pool_seed",
    "evaluation",
    "profiles"
  ],
  "additionalProperties": false
}
